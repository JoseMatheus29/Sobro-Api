# Copie para .env. Nunca comite o .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://sobro:sobro@localhost:5432/sobro
# Mínimo de 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-longo-com-pelo-menos-32-caracteres
# Pool de conexões (o Heroku Postgres Essential-0 aceita 20 no total).
DB_POOL_MAX=10
# Heroku Postgres: true (TLS obrigatório, certificado autoassinado).
DB_SSL=false
# Heroku/Render: a API fica atrás de um proxy.
TRUST_PROXY=false
# Versão mínima do app aceita (X-App-Version). Vazio = aceita todas.
MIN_APP_VERSION=
# E-mail de redefinição de senha (Resend). Sem chave, o link vai só para o log em desenvolvimento.
RESEND_API_KEY=
MAIL_FROM=Sobrô? <nao-responda@exemplo.com>
# Endereço que o link do e-mail abre (tela do app ou página web). O token vai como #token=.
RESET_PASSWORD_URL=https://exemplo.com/redefinir-senha
# Fuso do "hoje" da geração de recorrências.
APP_TIMEZONE=America/Sao_Paulo
